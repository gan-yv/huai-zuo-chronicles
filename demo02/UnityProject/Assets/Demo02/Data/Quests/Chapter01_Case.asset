    Lines:
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u4F60\u80AF\u5148\u60F3\u7740\u963F\u781A\uFF0C\u6211\u5C31\u628A\u77E5\u9053\u7684\u90FD\u544A\u8BC9\u4F60\u3002\u540E\u5899\u4E0A\u7684\u65E7\u6F06\u3001\u8D26\u53F0\u7684\u80CC\u9762\uFF0C\u8FD8\u6709\u5B98\u7F72\u90A3\u679A\u5C01\u6761\uFF0C\u90FD\u522B\u6F0F\u3002"
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u6C88\u781A\u4E0D\u4F1A\u65E0\u7F18\u65E0\u6545\u5E26\u8D70\u8D26\u9875\u3002\u53BB\u627E\u65E7\u8857\u62DB\u724C\u3001\u76D0\u4ED3\u8D26\u724C\u548C\u5B98\u5E9C\u5C01\u6761\u3002\u4E09\u5F20\u7EB8\u653E\u5728\u4E00\u8D77\uFF0C\u624D\u6709\u4EBA\u80AF\u4FE1\u3002"
