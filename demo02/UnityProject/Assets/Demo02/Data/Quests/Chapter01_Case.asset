      Stance: 0
      EvidencePlan: 0
      StoryFactId:
    ShowChoicesImmediately: 0
  - Id: shenbo-cross-examine-teahouse
    NpcId: shenbo
    InteractionPrompt: "E  \u628A\u8336\u8086\u65C1\u8BC1\u544A\u8BC9\u6C88\u4F2F"
    Conditions:
    - Type: 1
      Stage: 3
      Stance: 0
      EvidencePlan: 0
      Conclusion: 0
      EvidenceId:
      StoryFactId:
      Negate: 0
    - Type: 8
      Stage: 0
      Stance: 0
      EvidencePlan: 0
      Conclusion: 0
      EvidenceId:
      StoryFactId: teahouse-cart-testimony
      Negate: 0
    Lines:
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u8336\u8086\u638C\u67DC\u4E5F\u770B\u89C1\u4E86\uFF1F\u521D\u4E94\u5C01\u4ED3\u65F6\u95E8\u5916\u6CA1\u6709\u8F66\uFF0C\u521D\u4E03\u540E\u534A\u591C\u90A3\u4E03\u8F86\u8F66\u624D\u4ECE\u540E\u5DF7\u8FC7\u53BB\u2026\u2026"
    - speaker: "\u4E3B\u89D2"
      text: "\u4E24\u5904\u8BC1\u8BCD\u5BF9\u4E0A\u4E86\u3002\u5C01\u6761\u5148\u5199\u597D\uFF0C\u76D0\u8F66\u540E\u5165\u57CE\u3002\u73B0\u5728\u53EA\u9700\u8981\u8BA9\u6C88\u4F2F\u7684\u8BF4\u6CD5\u548C\u8D26\u724C\u5E76\u6392\u51FA\u73B0\u3002"
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u6309 T\u3002\u522B\u8BA9\u90A3\u4E24\u4E2A\u4EBA\u53EA\u662F\u5404\u81EA\u8BF4\u4E86\u4E00\u6BB5\u8BDD\uFF0C\u8981\u8BA9\u4ED6\u4EEC\u5728\u65F6\u95F4\u4E0A\u4E92\u76F8\u649E\u7834\u3002"
    Choices: []
    CompletionEffects: []
    ShowChoicesImmediately: 0
  - Id: shenbo-cross-examine-protected
    NpcId: shenbo
    InteractionPrompt: "E  \u8BF7\u6C88\u4F2F\u91CD\u8FF0\u5C01\u6761\u8D34\u4E0A\u7684\u65F6\u95F4"
    Conditions:
    - Type: 1
      Stage: 3
      Stance: 0
