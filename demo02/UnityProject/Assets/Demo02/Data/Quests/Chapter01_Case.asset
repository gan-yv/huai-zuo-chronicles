    InteractionPrompt: "E  \u628A\u4E09\u5904\u8BB0\u5F55\u4EA4\u7ED9\u6C88\u4F2F\u8FA8\u8BA4"
    Conditions:
    - Type: 1
      Stage: 2
      Stance: 0
      EvidencePlan: 0
      Conclusion: 0
      EvidenceId:
      StoryFactId:
      Negate: 0
    Lines:
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u8FD9\u4E09\u7B14\u2026\u2026\u90FD\u662F\u963F\u781A\u7684\u5B57\u3002\u4E03\u8F66\u76D0\u4ECE\u76D0\u5F15\u5DF7\u5165\u57CE\uFF0C\u590D\u6838\u7B7E\u5B57\u4E5F\u662F\u4ED6\u3002"
    - speaker: "\u4E3B\u89D2"
      text: "\u5C01\u6761\u662F\u8F6C\u8FD0\u526F\u4F7F\u9646\u5D07\u7684\uFF0C\u65E5\u671F\u5374\u5728\u65E7\u8857\u6D88\u5931\u524D\u4E00\u5929\u3002\u4ED6\u4E0D\u662F\u4E8B\u540E\u63A9\u76D6\uFF0C\u800C\u662F\u63D0\u524D\u5199\u597D\u4E86\u7ED3\u5C40\u3002"
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u6240\u4EE5\u963F\u781A\u4E0D\u662F\u9003\u4E86\u3002\u662F\u6709\u4EBA\u628A\u79C1\u76D0\u7684\u8D26\u3001\u76D0\u5F15\u5DF7\uFF0C\u8FD8\u6709\u77E5\u60C5\u7684\u963F\u781A\u4E00\u8D77\u4ECE\u7EB8\u4E0A\u62B9\u6389\u4E86\u3002"
    - speaker: "\u4E3B\u89D2"
      text: "\u7B49\u7B49\u3002\u5C01\u6761\u548C\u8D26\u724C\u7684\u65E5\u671F\u5BF9\u4E0D\u4E0A\u3002\u628A\u6C88\u4F2F\u7684\u8BF4\u6CD5\u4E0E\u4E03\u8F66\u76D0\u8D26\u724C\u653E\u5728\u4E00\u8D77\uFF0C\u5E94\u8BE5\u80FD\u770B\u51FA\u9646\u5D07\u7A76\u7ADF\u5728\u4EC0\u4E48\u65F6\u5019\u51B3\u5B9A\u62B9\u6389\u963F\u781A\u3002"
    Choices:
    - Text: "\u628A\u590D\u5236\u8BB0\u5F55\u9001\u5165\u5B98\u7F72\uFF0C\u8BA9\u6240\u6709\u4EBA\u90FD\u770B\u89C1\u3002"
      Conditions: []
      Effects:
      - Type: 2
        Stance: 0
        EvidencePlan: 1
        StoryFactId:
    - Text: "\u5148\u85CF\u4F4F\u8BC1\u636E\uFF0C\u4FDD\u62A4\u6C88\u4F2F\u548C\u5269\u4F59\u8BC1\u4EBA\u3002"
      Conditions: []
      Effects:
      - Type: 2
        Stance: 0
        EvidencePlan: 2
        StoryFactId:
    CompletionEffects:
