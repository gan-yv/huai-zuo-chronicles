      text: "\u951A\u70B9\u5B89\u9759\u4E0B\u6765\u4E86\u3002\u53EF\u8857\u5C3E\u90A3\u5757\u5730\u65B9\u2026\u2026\u50CF\u88AB\u4EBA\u4ECE\u7EB8\u4E0A\u786C\u751F\u751F\u6495\u5F00\u3002"
    - speaker: "\u4E3B\u89D2"
      text: "\u6C88\u781A\u7684\u540D\u5B57\u8FD8\u5728\u88C2\u7F1D\u53E6\u4E00\u4FA7\u3002\u538B\u4E0B\u65F6\u7F1D\uFF0C\u6211\u5C31\u80FD\u770B\u89C1\u6700\u540E\u90A3\u4E00\u9875\u3002"
