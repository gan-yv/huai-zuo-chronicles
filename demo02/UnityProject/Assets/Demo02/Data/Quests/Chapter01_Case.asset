  m_Name: Chapter01_Case
  m_EditorClassIdentifier: Assembly-CSharp::Demo02.Narrative.CaseDefinition
  contentVersion: 4
  caseId: chapter-01
  title: "\u6D88\u5931\u7684\u76D0\u5F15"
  chapterLabel: CHAPTER 01
  culpritEvidenceId: official-seal
  evidence:
  - Id: old-street-sign
    Title: "\u76D0\u5F15\u5DF7\u95E8\u724C"
    Detail: "\u65E7\u6F06\u4E0B\u85CF\u7740\u201C\u76D0\u5F15\u5DF7\u201D\u4E09\u5B57\u3002\u8FD9\u91CC\u662F\u76D0\u8239\u5165\u57CE\u540E\u7684\u7B2C\u4E00\u5904\u9A8C\u5F15\u70B9\u3002"
    InteractionPrompt: "E  \u8C03\u67E5\u65E7\u8857\u95E8\u724C"
    DiscoveredText: "\u95E8\u724C\u80CC\u9762\u522E\u7740\u4E00\u5C42\u65E7\u6F06\u3002\u5BF9\u7740\u5149\u80FD\u8BA4\u51FA\u201C\u76D0\u5F15\u5DF7\u201D\uFF0C\u4E09\u679A\u94DC\u9489\u4E0B\u8FD8\u523B\u7740\uFF1A\u897F\u4ED3\u3001\u4E1C\u9A8C\u3001\u4E2D\u518C\u3002"
  - Id: salt-ledger
    Title: "\u4E03\u8F66\u76D0\u8D26\u724C"
    Detail: "\u4E03\u8F66\u79C1\u76D0\u4E8E\u521D\u4E03\u540E\u534A\u591C\u5165\u57CE\uFF0C\u590D\u6838\u7B7E\u5B57\u4E3A\u6C88\u781A\u3002"
    InteractionPrompt: "E  \u8C03\u67E5\u76D0\u4ED3\u8D26\u724C"
    DiscoveredText: "\u8D26\u724C\u80CC\u9762\u6B8B\u7559\u4E03\u8F66\u76D0\u7684\u62BC\u8FD0\u7F16\u53F7\u3002\u590D\u6838\u7B7E\u5B57\u662F\u201C\u6C88\u781A\u201D\uFF0C\u5165\u57CE\u65E5\u671F\u4E3A\u521D\u4E03\u540E\u534A\u591C\u3002"
  - Id: official-seal
    Title: "\u9646\u5D07\u9664\u540D\u5C01\u6761"
    Detail: "\u5C01\u6761\u65E5\u671F\u65E9\u4E8E\u65E7\u8857\u6D88\u5931\u4E00\u5929\uFF0C\u80CC\u9762\u5199\u7740\u201C\u77E5\u60C5\u4EBA\u6C88\u781A\uFF0C\u5B9C\u9664\u540D\u201D\u3002"
    InteractionPrompt: "E  \u8C03\u67E5\u5B98\u5E9C\u5C01\u6761"
    DiscoveredText: "\u5C01\u6761\u5C5E\u4E8E\u8F6C\u8FD0\u526F\u4F7F\u9646\u5D07\uFF0C\u65E5\u671F\u6BD4\u76D0\u5F15\u5DF7\u4ECE\u5730\u56FE\u6D88\u5931\u65E9\u4E00\u5929\u3002\u80CC\u9762\u8FD8\u6709\u4E00\u884C\u5C0F\u5B57\uFF1A\u77E5\u60C5\u4EBA\u6C88\u781A\uFF0C\u5B9C\u9664\u540D\u3002"
  testimonies:
  - Id: shenbo-seal-date
    Source: "\u6C88\u4F2F \xB7 \u5B88\u4ED3\u4EBA"
    Text: "\u5C01\u6761\u662F\u521D\u4E94\u508D\u665A\u8D34\u4E0A\u7684\u3002\u90A3\u5929\u963F\u781A\u8FD8\u5728\u4ED3\u91CC\uFF0C\u95E8\u5916\u8FD8\u6CA1\u6709\u90A3\u4E03\u8F66\u76D0\u3002"
  - Id: teahouse-salt-carts
    Source: "\u8336\u94FA\u4F19\u8BA1 \xB7 \u8857\u53E3"
    Text: "\u521D\u4E94\u5230\u521D\u516B\u90FD\u89C1\u8FC7\u76D0\u8F66\uFF0C\u6211\u8BB0\u4E0D\u6E05\u4E03\u8F66\u7A76\u7ADF\u662F\u5728\u54EA\u4E00\u591C\u5378\u4E0B\u7684\u3002"
  - Id: clerk-removal-order
    Source: "\u5B98\u7F72\u6284\u4E66\u540F \xB7 \u518C\u9875\u65C1\u8BC1"
    Text: "\u65E7\u8857\u7684\u540D\u5B57\u662F\u5728\u5C01\u4ED3\u4E4B\u540E\uFF0C\u624D\u4ECE\u5B98\u7F72\u518C\u9875\u4E0A\u4E00\u8D77\u6D88\u5931\u7684\u3002"
  contradiction:
    StatementId: shenbo-seal-date
    EvidenceId: salt-ledger
    Explanation: "\u521D\u4E94\u7684\u5C01\u6761\u5DF2\u7ECF\u5199\u660E\u8981\u628A\u6C88\u781A\u9664\u540D\uFF0C\u4E03\u8F66\u76D0\u5374\u5728\u521D\u4E03\u591C\u91CC\u624D\u5165\u57CE\u3002\u9664\u540D\u53D1\u751F\u5728\u79C1\u76D0\u5165\u57CE\u4E4B\u524D\uFF0C\u8BF4\u660E\u9646\u5D07\u4E0D\u662F\u67E5\u6848\u540E\u5904\u7F6E\uFF0C\u800C\u662F\u63D0\u524D\u62B9\u6389\u77E5\u60C5\u4EBA\u3002"
    FirstHint: "\u8FD9\u4E24\u4EFD\u8BB0\u5F55\u53EF\u4EE5\u540C\u65F6\u6210\u7ACB\u3002\u5BFB\u627E\u4E00\u4EFD\u5199\u6709\u5177\u4F53\u65E5\u671F\u3001\u53E6\u4E00\u4EFD\u8BB0\u5F55\u540C\u4E00\u4E8B\u4EF6\u5148\u540E\u7684\u5185\u5BB9\u3002"
    RepeatedHint: "\u518D\u6BD4\u5BF9\u4E00\u6B21\u65F6\u95F4\u3002\u6C88\u4F2F\u8BF4\u7684\u662F\u5C01\u6761\u4F55\u65F6\u8D34\u4E0A\uFF0C\u8D26\u724C\u8BB0\u5F55\u7684\u662F\u4E03\u8F66\u76D0\u4F55\u65F6\u5165\u57CE\u3002"
  stageCopy:
  - Stage: 0
    Objective: "\u524D\u5F80\u65E7\u4ED3\u5185\u9662\uFF0C\u8BE2\u95EE\u5B88\u4ED3\u4EBA\u6C88\u4F2F"
    Reasoning: "\u6C88\u781A\u5931\u8E2A\u540E\uFF0C\u5B98\u7F72\u548C\u8857\u574A\u540C\u65F6\u5FD8\u8BB0\u4E86\u4ED6\u3002\u5148\u8BE2\u95EE\u6C88\u4F2F\uFF0C\u786E\u8BA4\u6700\u540E\u7559\u4E0B\u7684\u4E09\u5904\u8BB0\u5F55\u3002"
  - Stage: 1
    Objective: "\u8C03\u67E5\u76D0\u5F15\u5DF7\u7559\u4E0B\u7684\u8BB0\u5F55  {0}/{1}"
    Reasoning: "\u6C88\u781A\u5E26\u8D70\u4E86\u4E03\u9875\u79C1\u76D0\u8D26\u7C3F\u3002\u95E8\u724C\u3001\u8D26\u724C\u4E0E\u5B98\u5E9C\u5C01\u6761\u5FC5\u987B\u4E92\u76F8\u5370\u8BC1\uFF0C\u624D\u80FD\u8BC1\u660E\u76D0\u5F15\u5DF7\u66FE\u7ECF\u5B58\u5728\u3002"
  - Stage: 2
    Objective: "\u628A\u4E09\u5904\u8BB0\u5F55\u5E26\u56DE\u65E7\u4ED3\uFF0C\u8BA9\u6C88\u4F2F\u8FA8\u8BA4\u7B14\u8FF9"
    Reasoning: "\u4E09\u5904\u8BC1\u636E\u5DF2\u7ECF\u6307\u5411\u540C\u4E00\u4E2A\u591C\u665A\u3002\u6C88\u4F2F\u8BA4\u5F97\u513F\u5B50\u7684\u7B14\u8FF9\uFF0C\u4E0B\u4E00\u6B65\u5E94\u8BA9\u4ED6\u786E\u8BA4\u8D26\u724C\u7B7E\u540D\u3002"
  - Stage: 3
    Objective: "\u6309 T \u6253\u5F00\u8BC1\u8BCD\u5BF9\u7167\uFF0C\u627E\u51FA\u5C01\u6761\u4E0E\u76D0\u8F66\u8BB0\u5F55\u7684\u65F6\u95F4\u77DB\u76FE"
    Reasoning: "\u6C88\u4F2F\u8BF4\u5C01\u6761\u5728\u521D\u4E94\u508D\u665A\u8D34\u4E0A\uFF0C\u8D26\u724C\u5374\u8BB0\u5F55\u4E03\u8F66\u76D0\u76F4\u5230\u521D\u4E03\u591C\u91CC\u624D\u5165\u57CE\u3002\u5982\u679C\u4E24\u53E5\u8BDD\u90FD\u6210\u7ACB\uFF0C\u9664\u540D\u5C31\u53D1\u751F\u5728\u79C1\u76D0\u5165\u57CE\u4E4B\u524D\u3002"
  - Stage: 4
    Objective: "\u6309\u8BB0\u5F55\u987A\u5E8F\u7A33\u5B9A\u951A\u70B9\uFF1A{0} /
      {1}/{2}"
    Reasoning: "\u9646\u5D07\u7684\u5C01\u6761\u6BD4\u76D0\u5F15\u5DF7\u6D88\u5931\u65E9\u4E00\u5929\uFF0C\u8BF4\u660E\u9664\u540D\u662F\u9884\u8C0B\u3002\u95E8\u724C\u80CC\u9762\u7684\u94DC\u9489\u987A\u5E8F\u662F\u201C\u897F\u4ED3\u3001\u4E1C\u9A8C\u3001\u4E2D\u518C\u201D\uFF0C\u9519\u5E8F\u4F1A\u91CD\u7F6E\u951A\u70B9\u3002"
  - Stage: 5
    Objective: "\u524D\u5F80\u8857\u5C3E\uFF0C\u538B\u4E0B\u88AB\u6495\u5F00\u7684\u8BB0\u5F55"
    Reasoning: "\u5B8C\u6574\u8BC1\u636E\u94FE\u5DF2\u7ECF\u5F62\u6210\u3002\u8857\u5C3E\u65F6\u7F1D\u662F\u76D0\u5F15\u5DF7\u88AB\u6495\u6389\u7684\u7F3A\u53E3\uFF0C\u538B\u4E0B\u5B83\u624D\u80FD\u8BFB\u53D6\u6700\u540E\u4E00\u9875\u3002"
  - Stage: 6
    Objective: "\u5728\u8857\u5C3E\u51B3\u5B9A\u76D0\u5F15\u5DF7\u4E0E\u6C88\u781A\u7684\u547D\u8FD0"
    Reasoning: "\u6062\u590D\u65E7\u8857\u4F1A\u8BA9\u771F\u76F8\u91CD\u65B0\u8FDB\u5165\u5B98\u518C\uFF0C\u4E5F\u4F1A\u5F15\u6765\u9646\u5D07\u7684\u52BF\u529B\uFF1B\u5C01\u5B58\u65E7\u8857\u80FD\u6362\u6765\u7A33\u5B9A\uFF0C\u5374\u4F1A\u518D\u6B21\u62B9\u53BB\u6C88\u781A\u3002"
  - Stage: 7
    Objective: "\u8C03\u67E5\u5DF2\u7ECF\u7ED3\u675F"
    Reasoning: "\u76D0\u5F15\u5DF7\u7684\u547D\u8FD0\u5DF2\u7ECF\u786E\u5B9A\u3002"
  conclusionCopy:
  - Conclusion: 1
    Objective: "\u76D0\u5F15\u5DF7\u91CD\u65B0\u5165\u518C\uFF0C\u6C88\u781A\u7684\u540D\u5B57\u56DE\u5230\u57CE\u5E02\u8BB0\u5F55\u4E2D"
    Reasoning: "\u76D0\u5F15\u5DF7\u91CD\u65B0\u5165\u518C\uFF0C\u6C88\u781A\u7684\u540D\u5B57\u6062\u590D\u3002\u9646\u5D07\u79C1\u76D0\u6848\u5C06\u6210\u4E3A\u4E0B\u4E00\u573A\u51B2\u7A81\u7684\u5165\u53E3\u3002"
  - Conclusion: 2
    Objective: "\u76D0\u5F15\u5DF7\u88AB\u6C38\u4E45\u5C01\u5B58\uFF0C\u6C88\u781A\u53EA\u7559\u5728\u4F60\u7684\u4FEE\u590D\u8BB0\u5F55\u91CC"
    Reasoning: "\u76D0\u5F15\u5DF7\u88AB\u5C01\u5B58\uFF0C\u57CE\u5E02\u8BB0\u5F55\u6062\u590D\u7A33\u5B9A\u3002\u6C88\u781A\u4ECD\u53EA\u5B58\u5728\u4E8E\u4F60\u7684\u79C1\u4EBA\u4FEE\u590D\u8BB0\u5F55\u4E2D\u3002"
  dialogueScripts:
  - Id: shenbo-arrival
    NpcId: shenbo
    InteractionPrompt: "E  \u8BE2\u95EE\u6C88\u781A\u5931\u8E2A\u7684\u4E8B"
    Conditions:
    - Type: 1
      Stage: 0
      Stance: 0
      EvidencePlan: 0
      Conclusion: 0
      EvidenceId:
      StoryFactId:
      Negate: 0
    Lines:
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u4F60\u4E5F\u662F\u4E3A\u90A3\u6761\u4E0D\u5B58\u5728\u7684\u8857\u6765\u7684\uFF1F\u4ECA\u65E9\u6211\u53BB\u5B98\u7F72\u62A5\u5B98\uFF0C\u4ED6\u4EEC\u8BF4\u6211\u4ECE\u6765\u6CA1\u6709\u513F\u5B50\u3002"
    - speaker: "\u4E3B\u89D2"
      text: "\u5B98\u7F72\u6536\u5230\u4E00\u6279\u76D0\u5F15\uFF0C\u4EA4\u8D27\u5730\u70B9\u5199\u7740\u2018\u76D0\u5F15\u5DF7\u2019\u3002\u6211\u5728\u5E7F\u9675\u5730\u56FE\u4E0A\u627E\u4E0D\u5230\u8FD9\u4E2A\u540D\u5B57\u3002"
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u76D0\u5F15\u5DF7\u5C31\u662F\u8FD9\u6761\u65E7\u8857\u4ECE\u524D\u7684\u540D\u5B57\u3002\u6211\u513F\u5B50\u6C88\u781A\u5B88\u7740\u76D0\u4ED3\u8D26\u3002\u6628\u591C\u4ED6\u5E26\u8D70\u4E86\u4E03\u9875\u8D26\u7C3F\uFF0C\u518D\u6CA1\u56DE\u6765\u3002"
    - speaker: "\u4E3B\u89D2"
      text: "\u5E26\u6211\u53BB\u770B\u4ED6\u6700\u540E\u7559\u4E0B\u7684\u4E1C\u897F\u3002\u65E7\u8857\u62DB\u724C\u3001\u76D0\u4ED3\u8D26\u724C\u3001\u5B98\u5E9C\u5C01\u6761\u2014\u2014\u4E09\u5904\u8BB0\u5F55\u82E5\u6307\u5411\u540C\u4E00\u4E2A\u4EBA\uFF0C\u5C31\u80FD\u628A\u4ED6\u627E\u56DE\u6765\u3002"
    Choices:
    - Text: "\u6211\u6309\u8BB0\u5F55\u529E\u4E8B\u3002\u8BC1\u636E\u9F50\u4E86\uFF0C\u624D\u6709\u8D44\u683C\u8C08\u6551\u4EBA\u3002"
      Conditions: []
      Effects:
      - Type: 1
        Stance: 1
