    - Type: 8
      Stage: 0
      Stance: 0
      EvidencePlan: 0
      Conclusion: 0
      EvidenceId:
      StoryFactId: teahouse-keeper-protected
      Negate: 0
    Lines:
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u8336\u8086\u90A3\u8FB9\u4F60\u6CA1\u7EE7\u7EED\u8FFD\u95EE\uFF1F\u505A\u5F97\u5BF9\u3002\u9646\u5D07\u7684\u4EBA\u5DF2\u7ECF\u5728\u8857\u53E3\u6253\u542C\u8C01\u8FD8\u8BB0\u5F97\u6C88\u781A\u3002"
    - speaker: "\u4E3B\u89D2"
      text: "\u638C\u67DC\u77E5\u9053\u7684\u5DF2\u7ECF\u591F\u591A\u4E86\u3002\u73B0\u5728\u628A\u4F60\u8BF4\u7684\u5C01\u6761\u65E5\u671F\u548C\u8D26\u724C\u4E0A\u7684\u5165\u57CE\u65E5\u671F\u653E\u5728\u4E00\u8D77\u3002"
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u521D\u4E94\u508D\u665A\u8D34\u7684\u5C01\u6761\uFF0C\u521D\u4E03\u540E\u534A\u591C\u624D\u5230\u7684\u76D0\u8F66\u3002\u6309
        T\uFF0C\u8BA9\u4ED6\u4EEC\u5E76\u6392\u649E\u4E00\u6B21\u3002"
    Choices: []
    CompletionEffects: []
    ShowChoicesImmediately: 0
  - Id: shenbo-cross-examine
    NpcId: shenbo
    InteractionPrompt: "E  \u8BF7\u6C88\u4F2F\u91CD\u8FF0\u5C01\u6761\u8D34\u4E0A\u7684\u65F6\u95F4"
    Conditions:
    - Type: 1
      Stage: 3
      Stance: 0
      EvidencePlan: 0
      Conclusion: 0
      EvidenceId:
      StoryFactId:
      Negate: 0
    Lines:
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u5C01\u6761\u662F\u521D\u4E94\u508D\u665A\u8D34\u4E0A\u7684\u3002\u90A3\u5929\u963F\u781A\u8FD8\u5728\u4ED3\u91CC\uFF0C\u4ED6\u4EB2\u624B\u6570\u8FC7\u95E8\u5916\u7684\u7A7A\u76D0\u8F66\u3002"
    - speaker: "\u4E3B\u89D2"
      text: "\u53EF\u8D26\u724C\u5199\u7740\u4E03\u8F66\u76D0\u521D\u4E03\u591C\u624D\u5165\u57CE\u3002\u5C01\u6761\u6BD4\u79C1\u76D0\u65E9\u4E86\u4E24\u5929\uFF0C\u4ED6\u4EEC\u8981\u9664\u6389\u7684\u4E0D\u662F\u5DF2\u7ECF\u88AB\u6293\u4F4F\u7684\u628A\u67C4\uFF0C\u800C\u662F\u9884\u5B9A\u7684\u77E5\u60C5\u4EBA\u3002"
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u6309 T\uFF0C\u628A\u8FD9\u4E24\u53E5\u8BDD\u5E76\u6392\u653E\u5728\u6848\u5377\u4E0A\u3002\u522B\u53EA\u770B\u5B83\u4EEC\u5404\u81EA\u5199\u4E86\u4EC0\u4E48\uFF0C\u8981\u770B\u54EA\u4E00\u53E5\u5148\u53D1\u751F\u3002"
    Choices: []
    CompletionEffects: []
    ShowChoicesImmediately: 0
  - Id: shenbo-anchor-person
    NpcId: shenbo
    InteractionPrompt: "E  \u8BE2\u95EE\u5982\u4F55\u7A33\u5B9A\u65F6\u95F4\u951A\u70B9"
    Conditions:
    - Type: 1
      Stage: 4
