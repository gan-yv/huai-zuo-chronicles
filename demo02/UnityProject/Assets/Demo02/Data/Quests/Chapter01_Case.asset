      Conclusion: 0
      EvidenceId:
      StoryFactId:
      Negate: 0
    Lines:
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u963F\u781A\u82E5\u8FD8\u542C\u5F97\u89C1\uFF0C\u4ED6\u4F1A\u8BB0\u5F97\u4F60\u521A\u624D\u7684\u8BDD\u3002\u53BB\u628A\u90A3\u4E9B\u95E8\u4E00\u6247\u6247\u627E\u51FA\u6765\u3002"
    - speaker: "\u5B88\u4ED3\u4EBA \u6C88\u4F2F"
      text: "\u963F\u781A\u5C0F\u65F6\u5019\u8BF4\uFF0C\u76D0\u4ED3\u7684\u706B\u5149\u7167\u5230\u65E7\u5899\u4E0A\uFF0C\u4F1A\u591A\u51FA\u4E00\u6392\u672C\u4E0D\u5B58\u5728\u7684\u95E8\u3002"
    - speaker: "\u4E3B\u89D2"
      text: "\u90A3\u662F\u65E7\u65F6\u5C42\u7559\u4E0B\u7684\u5F71\u5B50\u3002\u95E8\u724C\u4E0A\u5199\u7740\u201C\u897F\u4ED3\u3001\u4E1C\u9A8C\u3001\u4E2D\u518C\u201D\u3002\u6309\u8FD9\u4E2A\u987A\u5E8F\u7A33\u5B9A\u951A\u70B9\uFF0C\u9519\u5E8F\u4F1A\u8BA9\u5DF2\u7ECF\u7A33\u5B9A\u7684\u90E8\u5206\u91CD\u65B0\u6F02\u79FB\u3002"
    Choices: []
    CompletionEffects: []
    ShowChoicesImmediately: 0
