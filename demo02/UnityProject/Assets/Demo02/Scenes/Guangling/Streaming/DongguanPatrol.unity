  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Demo02.Interaction.WorldStoryNpcInteractable
  speakerName: "\u65B0\u6765\u7684\u811A\u592B"
  contentEvent: {fileID: 253026841}
  introLines:
  - speaker: "\u65B0\u6765\u7684\u811A\u592B"
    text: "\u90A3\u961F\u5DE1\u54E8\u628A\u4E00\u53EA\u65E7\u8D26\u888B\u62D6\u8FDB\u76D0\u4ED3\uFF0C\u8BF4\u91CC\u9762\u53EA\u5269\u5E9F\u7EB8\u3002\u53EF\u6211\u770B\u89C1\u5C01\u7B7E\u4E0A\u76D6\u7684\u662F\u5B98\u5370\u3002"
  - speaker: "\u4E3B\u89D2"
    text: "\u5DE1\u903B\u82E5\u771F\u662F\u67E5\u6848\uFF0C\u5C31\u4E0D\u4F1A\u628A\u5C01\u7B7E\u85CF\u8D77\u6765\u3002"
  readyLines:
  - speaker: "\u65B0\u6765\u7684\u811A\u592B"
    text: "\u961F\u4F0D\u6563\u4E86\u3002\u8D26\u888B\u8FD8\u5728\u4F9B\u684C\u540E\uFF0C\u6211\u6CA1\u6562\u78B0\u3002"
  - speaker: "\u65B0\u6765\u7684\u811A\u592B"
    text: "\u8FD9\u58F6\u70ED\u59DC\u6C64\u4F60\u5148\u62FF\u7740\uFF0C\u6F6E\u6C14\u91CD\uFF0C\u522B\u5728\u65E7\u4ED3\u91CC\u75C5\u5012\u3002"
  completedLines:
  - speaker: "\u65B0\u6765\u7684\u811A\u592B"
    text: "\u8857\u53E3\u4ECA\u5929\u5B89\u9759\u591A\u4E86\uFF0C\u6211\u4E5F\u8BE5\u56DE\u53BB\u642C\u8D27\u4E86\u3002"
