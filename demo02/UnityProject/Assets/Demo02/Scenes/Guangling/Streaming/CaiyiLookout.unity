    text: "\u7EB8\u6761\u65E2\u7136\u80FD\u7F1D\u8FDB\u8863\u670D\uFF0C\u5C31\u4E5F\u80FD\u4ECE\u8FD9\u91CC\u5E26\u51FA\u53BB\u3002"
  readyLines:
  - speaker: "\u88C1\u8863\u5B66\u5F92"
    text: "\u671B\u98CE\u7684\u4EBA\u8D70\u4E86\u3002\u6211\u5728\u88C1\u8863\u6848\u677F\u4E0B\u627E\u5230\u4E00\u5F20\u7A7A\u767D\u8D26\u9875\u3002"
  - speaker: "\u88C1\u8863\u5B66\u5F92"
    text: "\u4F60\u6BD4\u6211\u66F4\u9700\u8981\u5B83\u3002\u82E5\u771F\u80FD\u628A\u8857\u540D\u5199\u56DE\u6765\uFF0C\u8BB0\u5F97\u522B\u5199\u9519\u3002"
  completedLines:
  - speaker: "\u88C1\u8863\u5B66\u5F92"
    text: "\u9488\u811A\u5DF2\u7ECF\u62C6\u5E72\u51C0\u4E86\u3002\u5E0C\u671B\u4E0B\u6B21\u6765\uFF0C\u8FD9\u91CC\u53EA\u5269\u6B63\u5E38\u505A\u4E70\u5356\u7684\u4EBA\u3002"
