  lines:
  - speaker: "\u76D0\u4ED3\u642C\u8FD0\u5DE5"
    text: "\u65E7\u8857\u7684\u8D27\u6628\u591C\u8FD8\u5728\u4ED3\u5E93\u91CC\u3002\u4ECA\u65E9\u4E00\u5230\uFF0C\u8D26\u4E0A\u7684\u5165\u5E93\u8BB0\u5F55\u5374\u5168\u6CA1\u4E86\u3002"
  - speaker: "\u76D0\u4ED3\u642C\u8FD0\u5DE5"
