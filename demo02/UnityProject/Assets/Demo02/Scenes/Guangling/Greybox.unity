  speakerName: "\u7F3A\u9875\u8D26\u7C3F"
  interactionPrompt: "E  \u8C03\u67E5\u7F3A\u9875\u8D26\u7C3F"
  lines:
  - speaker: "\u7F3A\u9875\u8D26\u7C3F"
    text: "\u8D26\u7C3F\u4E2D\u95F4\u5C11\u4E86\u6574\u6574\u4E03\u9875\u3002\u6B8B\u7559\u7684\u88C5\u8BA2\u7EBF\u4E0A\uFF0C\u8FD8\u80FD\u770B\u51FA\u88AB\u4EBA\u5306\u5FD9\u6495\u8D70\u7684\u75D5\u8FF9\u3002"
  - speaker: "\u4E3B\u89D2"
    text: "\u8FD9\u4E9B\u9875\u4E0D\u662F\u81EA\u7136\u635F\u574F\u3002\u6709\u4EBA\u5148\u6539\u5199\u4E86\u8FD9\u91CC\uFF0C\u518D\u8BA9\u6574\u6761\u65E7\u8857\u4ECE\u8BB0\u5F55\u91CC\u6D88\u5931\u3002"
