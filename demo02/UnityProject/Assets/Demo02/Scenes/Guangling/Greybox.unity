  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Demo02.Interaction.NpcDialogueInteractable
  speakerName: "\u7EF8\u7F0E\u5546"
  interactionPrompt: "E  \u4E0E\u7EF8\u7F0E\u5546\u4EA4\u8C08"
  lines:
  - speaker: "\u7EF8\u7F0E\u5546"
    text: "\u6C88\u781A\u524D\u65E5\u6765\u626F\u8FC7\u4E00\u5C3A\u9752\u5E03\uFF0C\u8BF4\u8981\u7ED9\u7236\u4EB2\u7F1D\u4E2A\u65B0\u8D26\u888B\u3002\u94B1\u662F\u6211\u4EB2\u624B\u6536\u7684\uFF0C\u8D26\u4E0A\u5374\u627E\u4E0D\u5230\u8FD9\u7B14\u4E70\u5356\u3002"
  - speaker: "\u7EF8\u7F0E\u5546"
    text: "\u82E5\u8FDE\u4E70\u5356\u90FD\u80FD\u88AB\u6539\uFF0C\u4E1C\u5173\u8857\u8FD8\u7B97\u5F97\u4E0A\u662F\u8C01\u7684\u8857\uFF1F\u53BB\u65E7\u4ED3\u770B\u770B\u5427\uFF0C\u4ED6\u7236\u4EB2\u4E00\u76F4\u5B88\u5728\u90A3\u91CC\u3002"
