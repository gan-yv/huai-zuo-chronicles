  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Demo02.Interaction.NpcDialogueInteractable
  speakerName: "\u88C1\u8863\u94FA\u638C\u67DC"
  interactionPrompt: "E  \u4E0E\u88C1\u8863\u94FA\u638C\u67DC\u4EA4\u8C08"
  dialogueNpcId: 
  lines:
  - speaker: "\u88C1\u8863\u94FA\u638C\u67DC"
    text: "\u76D0\u5F15\u5DF7\u4ECE\u524D\u5C31\u5728\u65E7\u4ED3\u540E\u9762\u3002\u90A3\u91CC\u7684\u5AB3\u5987\u5E38\u6765\u6211\u8FD9\u513F\u6311\u9752\u5E03\uFF0C\u8BF4\u76D0\u7070\u843D\u4E0A\u53BB\u4E5F\u4E0D\u663E\u810F\u3002"
  - speaker: "\u88C1\u8863\u94FA\u638C\u67DC"
    text: "\u8857\u548C\u8863\u88F3\u4E00\u6837\u3002\u5C11\u4E86\u4E00\u6BB5\uFF0C\u65C1\u4EBA\u672A\u5FC5\u770B\u5F97\u51FA\u6765\uFF0C\u4F4F\u5728\u8FD9\u91CC\u7684\u4EBA\u5374\u77E5\u9053\u3002"
