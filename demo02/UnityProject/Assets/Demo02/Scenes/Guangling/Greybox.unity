  lines:
  - speaker: "\u7EF8\u7F0E\u5546"
    text: "\u6C88\u781A\u524D\u65E5\u6765\u626F\u8FC7\u4E00\u5C3A\u9752\u5E03\uFF0C\u8BF4\u8981\u7ED9\u7236\u4EB2\u7F1D\u4E2A\u65B0\u8D26\u888B\u3002\u94B1\u662F\u6211\u4EB2\u624B\u6536\u7684\uFF0C\u8D26\u4E0A\u5374\u627E\u4E0D\u5230\u8FD9\u7B14\u4E70\u5356\u3002"
