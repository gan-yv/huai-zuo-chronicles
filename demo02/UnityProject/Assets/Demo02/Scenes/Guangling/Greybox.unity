  lines:
  - speaker: "\u8BF4\u4E66\u4EBA"
    text: "\u4E1C\u5173\u8857\u7684\u94FA\u5B50\u4E00\u65E5\u6BD4\u4E00\u65E5\u591A\uFF0C\u53EF\u8001\u4F4F\u6237\u5374\u4E00\u65E5\u6BD4\u4E00\u65E5\u5C11\u3002\u4F60\u8BF4\u662F\u751F\u610F\u53D8\u4E86\uFF0C\u8FD8\u662F\u4EBA\u53D8\u4E86\uFF1F"
  - speaker: "\u8BF4\u4E66\u4EBA"
    text: "\u57CE\u91CC\u7684\u6545\u4E8B\u603B\u8981\u6709\u4EBA\u8BB2\u3002\u6CA1\u4EBA\u8BB2\u7684\uFF0C\u4E45\u4E86\u5C31\u50CF\u4ECE\u6765\u6CA1\u53D1\u751F\u8FC7\u3002"
