  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Demo02.Interaction.NpcDialogueInteractable
  speakerName: "\u8BF4\u4E66\u4EBA"
  interactionPrompt: "E  \u4E0E\u8BF4\u4E66\u4EBA\u4EA4\u8C08"
  lines:
  - speaker: "\u8BF4\u4E66\u4EBA"
    text: "\u4E8C\u5341\u5E74\u524D\u6709\u573A\u76D0\u4ED3\u5927\u706B\uFF0C\u7B2C\u4E8C\u5929\u6574\u6761\u76D0\u5F15\u5DF7\u5C31\u4ECE\u5B98\u56FE\u4E0A\u6CA1\u4E86\u3002\u8001\u8F88\u4EBA\u90FD\u8BF4\uFF0C\u90A3\u4E0D\u662F\u706B\uFF0C\u662F\u6709\u4EBA\u62FF\u7EB8\u76D6\u4F4F\u4E86\u706B\u3002"
  - speaker: "\u8BF4\u4E66\u4EBA"
    text: "\u57CE\u91CC\u7684\u6545\u4E8B\u603B\u8981\u6709\u4EBA\u8BB2\u3002\u4F60\u82E5\u771F\u627E\u5230\u90A3\u4E03\u9875\u8D26\uFF0C\u522B\u8BA9\u5B83\u53EA\u7559\u5728\u5B98\u5E9C\u624B\u91CC\u3002"
