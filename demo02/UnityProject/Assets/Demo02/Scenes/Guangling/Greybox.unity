  lines:
  - speaker: "\u8336\u8086\u638C\u67DC"
    text: "\u6628\u591C\u6253\u70CA\u524D\uFF0C\u6C88\u781A\u5750\u5728\u9760\u7A97\u90A3\u5F20\u684C\uFF0C\u53CD\u590D\u6570\u4E03\u5F20\u8D26\u9875\u3002\u4ED6\u8D70\u65F6\u628A\u4E00\u679A\u76D0\u5F15\u94DC\u94B1\u843D\u5728\u684C\u4E0A\u3002"
  - speaker: "\u8336\u8086\u638C\u67DC"
    text: "\u4ECA\u65E9\u4F19\u8BA1\u95EE\u6211\u94DC\u94B1\u662F\u54EA\u6765\u7684\u3002\u6211\u7ADF\u4E00\u65F6\u60F3\u4E0D\u8D77\u6C88\u781A\u662F\u8C01\u3002\u8336\u51C9\u4E86\u8FD8\u80FD\u7EED\uFF0C\u4EBA\u4ECE\u7EB8\u4E0A\u6D88\u5931\uFF0C\u53EF\u5C31\u7EED\u4E0D\u56DE\u6765\u4E86\u3002"
